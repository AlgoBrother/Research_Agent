# Server-only — never prefix these with NEXT_PUBLIC_, or they'll ship to the browser.

# URL of your Python backend (Render/Fly/HF Spaces), no trailing slash.
ARXAGENT_BACKEND_URL=https://your-backend.onrender.com

# Long random string, shared with the backend. Generate with:
#   openssl rand -hex 32
ARXAGENT_BACKEND_SECRET=replace-with-a-long-random-secret

# Optional but recommended in production — free tier at upstash.com.
# Without these, the rate limiter falls back to an in-memory counter that
# only works for local `next dev`, not for a deployed multi-instance app.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
